# DEMO IS A FLAG, NOT AN ENVIRONMENT (docs/environments.md).
#
# Out-of-the-box evaluation inside an org's DEVELOPMENT environment: two independent
# sample-data families, each downloaded and checksum-verified from published object
# storage, registered as read-only datasources with a set of example pipelines. The
# `hardened` posture REFUSES a non-empty DATAPIPELINES_DEMO at boot.
#
#   ./app.sh --start --demo nyc            the NYC mobility family
#   ./app.sh --start --demo nyc,trade      both families, one box
#
# TRACKED, and that is the point (T117): the version numbers below used to live in a
# git-ignored scaffold, so two stacks in one week loaded a version the repo had already
# moved past and nobody could see it. A version bump is now a COMMIT, and
# scripts/sample-data/check-published.sh reads the values from THIS file.
#
# Raw compose (no app.sh) needs the family markers too — app.sh derives them from
# --demo, and the compose profiles gate the loader services:
#   docker compose -f deploy/compose.yml --env-file deploy/env/posture/development.env \
#     --env-file deploy/env/demo.env --env-file deploy/secrets.env \
#     --profile demo-nyc up -d
# with SAMPLE_NYC_ON=1 (and/or SAMPLE_TRADE_ON=1) set in your environment.

# The families this deployment loads. Empty = demo is off. app.sh --demo overrides it.
DATAPIPELINES_DEMO=nyc,trade

# Where the published artifacts live, and WHICH immutable version directory under them.
# Any change to the data is a new version directory (docs/deployment.md Appendix B).
SAMPLE_BASE_URL=https://datapipelines-co.s3.amazonaws.com/sample-data/mobility
SAMPLE_VERSION=v4
SAMPLE_TRADE_BASE_URL=https://datapipelines-co.s3.amazonaws.com/sample-data/trade
SAMPLE_TRADE_VERSION=v3

# The SELECT-only login the loader creates on Postgres and MySQL, and that the
# bootstrap datasources file resolves as a ${...} placeholder. The USER is not a
# secret; its passwords are, and they live in deploy/secrets.env.
SAMPLE_DB_USER=dp_demo_ro

# The demo's own posture inside the development posture (§7 of the sample-data design):
# every visitor gets their own workspace, and nobody registers a datasource of their own
# (an open datasource form on a reachable server is an SSRF and port-scan primitive).
DATAPIPELINES_WORKSPACES_PROVISIONING_MODE=auto-per-user
DATAPIPELINES_WORKSPACES_MEMBER_DATASOURCES_ENABLED=false

# Zero-setup login (auth.md §5A): the demo needs no OIDC client at all. The FIRST ADMIN
# gets a one-time password the app forces you to change at first sign-in. The password
# itself is a secret and is GENERATED into deploy/secrets.env by app.sh — never a
# constant in a tracked file, on an app that binds every interface.
DATAPIPELINES_AUTH_LOCAL_ENABLED=true
# The account that credential lands on. Set DATAPIPELINES_AUTH_BOOTSTRAP_ADMIN_EMAIL to
# YOUR address in deploy/secrets.env BEFORE the first start to claim admin — the seed
# fires once, at row creation, and a later change does not re-seed (auth.md §5A.2; the
# app logs event=auth.local.bootstrap_mismatch when the two disagree).
DATAPIPELINES_AUTH_BOOTSTRAP_ADMIN_EMAIL=demo-admin@demo.local

# Copy to deploy/secrets.env and fill in — deploy/secrets.env is GIT-IGNORED.
# `./app.sh --start` scaffolds it for you with generated values; this template is for
# a deployment you assemble yourself (Kubernetes Secret, systemd EnvironmentFile, a
# vault template, `set -a; . secrets.env` before `java -jar`).
#
# SECRETS ARE SEPARATE FROM SETTINGS (docs/environments.md "Secrets"). Settings are
# tracked in this repo so the repo is the source of truth; secrets are never tracked,
# and this file is the only place they live. Generate every value — a placeholder that
# ships is a published credential.
#
# app.sh passes this file LAST, so a value you set here always wins over the posture
# and demo files.

# --- required, no fallback -------------------------------------------------------
# openssl rand -base64 32   (must decode to >= 32 bytes)
DATAPIPELINES_JWT_SECRET=
# openssl rand -base64 32   (must decode to EXACTLY 32 bytes). Losing this makes every
# stored datasource credential unrecoverable — back it up before you need it.
DATAPIPELINES_DB_ENCRYPTION_KEY=
# openssl rand -base64 24. Under deploy/compose.yml this is ALSO the password compose
# gives the metadata-DB container, so the two sides cannot drift.
SPRING_DATASOURCE_PASSWORD=
# openssl rand -base64 24. Same: compose starts Redis with `--requirepass` on it.
DATAPIPELINES_REDIS_PASSWORD=

# --- the deployment's own identity ------------------------------------------------
# The exact external origin, scheme + host [+ port], no trailing slash. REQUIRED when
# any OIDC provider is configured: redirect URIs are built absolutely from it.
DATAPIPELINES_AUTH_BASE_URL=https://datapipelines.example.com

# --- authentication ----------------------------------------------------------------
# OIDC (the stock google provider in the image's application.yml). Empty = ignored with
# a WARN, so a local-accounts-only deployment starts with zero providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This email becomes admin when its user row is created (auth.md §4.4).
DATAPIPELINES_AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Restrict login to these email domains (comma list; empty = open).
DATAPIPELINES_AUTH_ALLOWLIST_DOMAINS=
# Local password accounts (auth.md §5A). The seed is the FIRST ADMIN's ONE-TIME
# credential and the app forces a change at first sign-in. REFUSED under the hardened
# posture — create the first admin there from an existing admin's Users screen.
# DATAPIPELINES_AUTH_LOCAL_ENABLED=true
# DATAPIPELINES_AUTH_LOCAL_BOOTSTRAP_PASSWORD_HASH=   # ./gradlew :modules:auth:hashPassword
# DATAPIPELINES_AUTH_LOCAL_BOOTSTRAP_PASSWORD=        # plaintext alternative

# --- promotion (docs/versioning.md §10.6) -------------------------------------------
# Both are BEARER SECRETS, identical on the two peers. Empty server-key = this
# deployment refuses inbound promotion (fail closed).
# DATAPIPELINES_DEPLOYMENT_PROMOTION_SERVER_KEY=
# DATAPIPELINES_DEPLOYMENT_PROMOTION_TARGET_URL=
# DATAPIPELINES_DEPLOYMENT_PROMOTION_TARGET_KEY=

# --- demo only (deploy/env/demo.env turns the families on) --------------------------
# The SELECT-only sample login's passwords. Hex, not base64: hex can never contain a
# Postgres dollar-quote tag and stays shell-quiet everywhere. openssl rand -hex 24
# SAMPLE_PG_PASSWORD=
# SAMPLE_MYSQL_PASSWORD=
# SAMPLE_MYSQL_ROOT_PASSWORD=

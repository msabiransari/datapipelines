# defaults.env — THE settings file. Tracked, non-secret, and the only one.
#
# There is exactly one pair of files, everywhere, in this order:
#
#     deploy/env/defaults.env     this file. Tracked. Every non-secret variable the
#                                 app reads, with the value this deployment defaults to.
#     deploy/secrets.env          GIT-IGNORED. Every secret, plus every override that
#                                 belongs to THIS deployment (posture, env name, the
#                                 metadata DB URL, the external base URL, the OIDC
#                                 client). Later file wins, so anything here can be
#                                 overridden there. deploy/secrets.env.example is its
#                                 template and names every variable you may set.
#
# That order is the whole loader story, and it is the same under every loader
# (docs/environments.md §4):
#
#   docker compose -f deploy/compose.yml \
#     --env-file deploy/env/defaults.env --env-file deploy/secrets.env up -d
#   set -a; . deploy/env/defaults.env; . deploy/secrets.env; set +a; java -jar app.jar
#   kubectl create configmap dp-defaults --from-env-file=deploy/env/defaults.env
#   systemd:  EnvironmentFile=/etc/datapipelines/defaults.env   (then secrets.env)
#
# `./app.sh` passes exactly these two files, in this order, for every verb.
#
# WHAT IS NOT HERE, and why:
#
#   * SECRETS. Never, under any circumstance — this file is tracked. The credentials
#     and the three per-deployment identity values live in deploy/secrets.env
#     (docs/environments.md §6).
#   * POSTURE-DEPENDENT DEFAULTS — `DATAPIPELINES_DEPLOYMENT_AUTHORING_ENABLED` and
#     `DATAPIPELINES_AUTH_COOKIE_SECURE`. Their default IS the posture, and it is
#     carried by the profile `DATAPIPELINES_POSTURE` selects
#     (`application-development.yml` / `application-hardened.yml`). An env file that
#     named them would outrank the profile and every posture would ship the same
#     stance — which is exactly what happened before 081. deploy/compose.yml passes
#     them through only when they are actually SET (`${VAR:+…}`), so an operator can
#     still override them in deploy/secrets.env and the profile wins otherwise.
#     `PostureDefaultsSpecDriftTest` pins both halves of that rule.
#
# Most values below are the SHIPPED DEFAULT — a line left as-is changes nothing.
# The handful that deliberately differ (a laptop's infrastructure, console logs, the
# out-of-the-box workspace mode) are declared in scripts/compose-env-audit.sh's
# DEFAULTS_ENV_OVERRIDES with their reason, and the audit fails the build if any
# other line drifts from application.yml. An empty value means the feature is off or
# the key is unset, not "blank".
#
# The `# §3.x` prefix on each comment is that variable's section in
# docs/configuration.md, which is where the full description lives.
#
# NOT LISTED (framework wiring, configuration.md §3.14):
#   SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE      connection pool size (10)
#   SERVER_PORT (8080)  MANAGEMENT_SERVER_PORT (9090)  MANAGEMENT_SERVER_ADDRESS (127.0.0.1)
#   SPRING_CONFIG_ADDITIONAL_LOCATION               mount your own yml (extra OIDC providers)
#   APP_HOST_PORT, IMAGE_TAG, APP_COMPOSE_PROJECT   deploy/compose.yml lane knobs only

# ----------------------------------------------------------------------------
# THE METADATA DATABASE AND REDIS
#
# The values below are the LAPTOP's infrastructure — `deploy/compose.laptop-infra.yml`
# on 127.0.0.1:5434 and :6381 (not 5432/6379, which collide with other local stacks).
# Any other deployment overrides the URL and host in deploy/secrets.env, which is
# where a real DB endpoint belongs anyway. `deploy/compose.yml` does not read these
# at all: on the compose network the database and Redis are the SERVICE names, so
# that file pins them as literals (declared in compose-env-audit.sh's overrides).
# The two passwords are secrets and live only in deploy/secrets.env; both compose
# files start their Postgres and Redis FROM those same variables, so there is one
# value per credential and no file can disagree with another about it.
# ----------------------------------------------------------------------------
# §3.14 The metadata database. Overridden in secrets.env for anything but a laptop.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/datapipelines
# §3.14 Its user. The password is a secret — deploy/secrets.env.
SPRING_DATASOURCE_USERNAME=datapipelines

# ----------------------------------------------------------------------------
# THE TWO VARIABLES an organisation actually sets (docs/environments.md)
# ----------------------------------------------------------------------------
# §3.23 The ORG's label for this deployment: [a-z0-9][a-z0-9_-]{0,31}. Nothing branches on it.
DATAPIPELINES_ENV=local
# §3.23 The PRODUCT's stance: development | hardened. It also SELECTS the Spring profile
# that carries the posture's own defaults. Set it to `hardened` in deploy/secrets.env for
# any real deployment; the app refuses to start for any DATAPIPELINES_ENV but `local`
# without one, and refuses a SPRING_PROFILES_ACTIVE that disagrees with it.
DATAPIPELINES_POSTURE=development
# §3.23 Sample-data families to load: nyc, trade (comma list). Empty = off. Refused under hardened.
DATAPIPELINES_DEMO=
# §3.18 (#224) The demo workspace's public api_caller key, shown on the demo-data page.
# Public by design; blank = the demo API is off; a changed value rotates the key on restart.
DATAPIPELINES_DEMO_API_KEY=dpk_DEMOPUBLIC42.THISKEYISPUBLICBYDESIGNDEMOONLYREADONLY222222222
# §3.22 (#224) The serve path's per-key request budget for api_caller keys. max-requests 0 = off.
DATAPIPELINES_ENDPOINTS_KEY_REQUEST_BUDGET_WINDOW_SECONDS=60
DATAPIPELINES_ENDPOINTS_KEY_REQUEST_BUDGET_MAX_REQUESTS=60
# §3.20 Which KeyProvider supplies datasource data keys. `env` is this build's only provider.
DATAPIPELINES_DB_KEY_PROVIDER=env
# §2 REQUIRED. The laptop infra's Redis; deploy/compose.yml pins the service name `redis`.
DATAPIPELINES_REDIS_HOST=localhost
# §3.1 Redis port. 6381 is compose.laptop-infra.yml's published port (6379 collides).
DATAPIPELINES_REDIS_PORT=6381

# ----------------------------------------------------------------------------
# Authentication (auth.md, configuration.md §3.4)
# ----------------------------------------------------------------------------
# §3.4 Comma list of email domains allowed to log in. Empty = open.
DATAPIPELINES_AUTH_ALLOWLIST_DOMAINS=
# §3.4 Acknowledge that a HARDENED deployment has no OIDC provider and uses local accounts only.
DATAPIPELINES_AUTH_ALLOW_LOCAL_ONLY=false
# §3.4 API-key lookup cache TTL.
DATAPIPELINES_AUTH_API_KEYS_CACHE_TTL_SECONDS=60
# §3.4 Hosts the avatar proxy may fetch Google's picture claim from (#197). Empty = no fetch; avatars render initials.
DATAPIPELINES_AUTH_GOOGLE_PICTURE_HOSTS=lh3.googleusercontent.com
# §3.4 Session JWT lifetime.
DATAPIPELINES_AUTH_JWT_TTL_HOURS=8
# §3.4 Local password accounts (auth.md §5A).
DATAPIPELINES_AUTH_LOCAL_ENABLED=false
# §3.4 How long that lockout lasts.
DATAPIPELINES_AUTH_LOCAL_LOCKOUT_DURATION_MINUTES=15
# §3.4 Failed local logins before lockout.
DATAPIPELINES_AUTH_LOCAL_LOCKOUT_MAX_FAILURES=5
# §3.4 Login attempts per minute per client address.
DATAPIPELINES_AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=10
# §3.4 CIDRs whose X-Forwarded-For names the real client. Empty = the header is ignored.
DATAPIPELINES_AUTH_TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# Bootstrap content and workspaces (configuration.md §3.17/§3.18)
# ----------------------------------------------------------------------------
# §3.18 Comma list of datasource manifests to register at boot. Empty = off.
DATAPIPELINES_BOOTSTRAP_DATASOURCES_FILE=
# §3.18 Comma list of example-content files to seed. Empty = off.
DATAPIPELINES_BOOTSTRAP_EXAMPLES_FILE=
# §3.17 Members (not just admins) may register datasources. Off out of the box: an open
# datasource form on a reachable server is an SSRF and port-scan primitive (sample-data §7).
DATAPIPELINES_WORKSPACES_MEMBER_DATASOURCES_ENABLED=false
# §3.26 Directories a file-backed datasource (H2 file:, SQLite, DuckDB file) may live under
# (186). Empty = no file-backed datasource is registrable by anyone. The demo families need
# the read-only sample volume — app.sh --demo exports /srv/sample for you.
DATAPIPELINES_DATASOURCES_FILE_ROOTS=
# §3.17 OPEN_JOIN and PROVISIONING_MODE were REMOVED in RBAC round 1 (D-R11) and are
# refused BY NAME at startup — setting either here refuses the boot. Workspaces are created
# by super admins; `demo` ships and every user with no membership joins it as a viewer.

# ----------------------------------------------------------------------------
# Execution, staging and results (configuration.md §3.2/§3.3/§3.5)
# ----------------------------------------------------------------------------
# §3.25 Bundled DuckDB extension directory for LAKE datasources (dp-lake). EMPTY here on
# purpose: this file also feeds bare `java -jar` runs, which have nothing bundled (the
# adapter then INSTALLs with egress). The shipped image exports the variable itself
# (Dockerfile ENV, /opt/duckdb/extensions), and deploy/compose.yml defaults to that path.
DATAPIPELINES_DUCKDB_EXTENSION_DIRECTORY=
# §3.25 (153, #136) Operator default memory_limit for every LAKE engine build when a
# datasource declares none of its own. EMPTY is the shipped default — the derived 25% of
# container memory, clamped 64 MiB-4 GiB. Set a DuckDB size string (e.g. 8GB) and restart
# to raise it; an invalid value fails fast at startup.
DATAPIPELINES_DUCKDB_MEMORY_LIMIT=
# §3.2 Whole-execution deadline.
DATAPIPELINES_EXECUTOR_EXECUTION_TIMEOUT_SECONDS=600
# §3.2 Per-node WALL-CLOCK deadline: render → connect → execute → stage → materialize.
DATAPIPELINES_EXECUTOR_NODE_TIMEOUT_SECONDS=300
# §3.2 Ceiling a node's own settings.timeout_seconds may ask for; refused at save above it.
DATAPIPELINES_EXECUTOR_NODE_TIMEOUT_MAX_SECONDS=900
# §3.2 (156, #2) Ceiling a pipeline's or a node's own settings.query_timeout_seconds may ask for.
DATAPIPELINES_EXECUTOR_NODE_QUERY_TIMEOUT_MAX_SECONDS=900
# §3.2 (156, #2) Per-dialect statement-timeout default; LAKE re-reads cold from object storage.
DATAPIPELINES_EXECUTOR_NODE_QUERY_TIMEOUT_SECONDS_BY_DIALECT_LAKE=180
# §3.2 How long a cancelled statement is waited on before it is abandoned and logged.
DATAPIPELINES_EXECUTOR_CANCEL_GRACE_SECONDS=5
# §3.2 fetchSize on every DQL source cursor — what makes it stream. 0 turns streaming off.
DATAPIPELINES_EXECUTOR_SOURCE_FETCH_SIZE=1000
# §3.2 Floor between two throttled live-progress writes for one execution.
DATAPIPELINES_EXECUTOR_PROGRESS_WRITE_INTERVAL_SECONDS=5
# §3.2 Floor between two periodic node_progress samples of one operation (149).
DATAPIPELINES_EXECUTOR_PROGRESS_SAMPLE_INTERVAL_SECONDS=1
# §3.2 Heartbeat cadence; the crash sweep reaps a RUNNING row at 3x this.
DATAPIPELINES_EXECUTOR_HEARTBEAT_SECONDS=15
# §3.2 (311) The bound on the two pipeline_executions lifecycle writes: a queryTimeout on the
# RUNNING insert and the terminal UPDATE, plus the emitter's caller-side wait (a database that
# never answers). A past-bound write is stated, never fabricated.
DATAPIPELINES_EXECUTOR_LIFECYCLE_WRITE_TIMEOUT_SECONDS=10
# §3.2 Per-JVM ceiling. N replicas admit N x this.
DATAPIPELINES_EXECUTOR_MAX_CONCURRENT_EXECUTIONS_PER_INSTANCE=100
# §3.2 Concurrent executions one user may hold.
DATAPIPELINES_EXECUTOR_MAX_CONCURRENT_EXECUTIONS_PER_USER=10
# §3.2 Nodes run in parallel within one execution.
DATAPIPELINES_EXECUTOR_MAX_PARALLEL_NODES=4
# §3.2 Per-node query timeout (a datasource may override its own).
DATAPIPELINES_EXECUTOR_NODE_QUERY_TIMEOUT_SECONDS=60
# Empty = derived: node-query-timeout-seconds + 30 (datasources.md §5.2, configuration.md §3.24).
DATAPIPELINES_DATASOURCES_RETIRE_CEILING_SECONDS=
# §3.27 Outbound mail — the SMTP submission port and STARTTLS (required, not opportunistic;
# the hardened posture refuses false). The server itself (host, from, credentials, the
# sys-ops sink) is this deployment's own, in deploy/secrets.env; mail is ON exactly when
# HOST and FROM are both set — there is no flag.
DATAPIPELINES_MAIL_PORT=587
DATAPIPELINES_MAIL_STARTTLS=true
# §3.16 Depth guard for PIPELINE-node composition.
DATAPIPELINES_PIPELINES_MAX_COMPOSITION_DEPTH=5
# §3.19 How long the SENDER remembers the promotion target's inventory, per workspace (178: the
# promoter lens evaluates versioning §10.2 on every read a promoter makes; one target call per
# window; an unreachable target is remembered for the same window). 0 disables the cache.
DATAPIPELINES_DEPLOYMENT_PROMOTION_INVENTORY_CACHE_TTL_SECONDS=60
# §3.5 Largest materialized result (bytes).
DATAPIPELINES_RESULT_MAX_SIZE_BYTES=104857600
# §3.5 Ceiling the DP-Result-Page-Rows header clamps to.
DATAPIPELINES_RESULT_PAGE_MAX_ROWS=100000
# §3.5 Default page size.
DATAPIPELINES_RESULT_PAGE_SIZE_ROWS=1000
# §3.5 Result TTL when a caller names none. min <= default <= max.
DATAPIPELINES_RESULT_TTL_DEFAULT_SECONDS=300
# §3.5 Highest TTL a caller may ask for.
DATAPIPELINES_RESULT_TTL_MAX_SECONDS=3600
# §3.5 Lowest TTL a caller may ask for.
DATAPIPELINES_RESULT_TTL_MIN_SECONDS=60
# §3.3 Rows inserted per batch into staging.
DATAPIPELINES_STAGING_H2_INSERT_BATCH_SIZE=1000
# §3.3 Cap on operational H2 connections per execution's staging pool (1 = single connection).
DATAPIPELINES_STAGING_H2_MAX_CONNECTIONS=4
# §3.3 Staging tempdb memory ceiling per execution.
DATAPIPELINES_STAGING_H2_MAX_MEMORY_MB=1024
# §3.3 H2 compatibility mode for the staging tempdb.
DATAPIPELINES_STAGING_H2_MODE=PostgreSQL
# §3.3 Staging query timeout.
DATAPIPELINES_STAGING_H2_QUERY_TIMEOUT_SECONDS=60
# §3.3 Rows fetched per batch out of staging.
DATAPIPELINES_STAGING_H2_RESULT_BATCH_SIZE=10000

# ----------------------------------------------------------------------------
# Streaming, limits and templates (configuration.md §3.6-§3.9, §3.22)
# ----------------------------------------------------------------------------
# §3.22 Published-endpoint timeout when the binding names none.
DATAPIPELINES_ENDPOINTS_TIMEOUT_DEFAULT_SECONDS=30
# §3.22 Highest published-endpoint timeout.
DATAPIPELINES_ENDPOINTS_TIMEOUT_MAX_SECONDS=300
# §3.22 Lowest published-endpoint timeout. >= 1.
DATAPIPELINES_ENDPOINTS_TIMEOUT_MIN_SECONDS=1
# §3.8 How long an Idempotency-Key is remembered.
DATAPIPELINES_IDEMPOTENCY_TTL_SECONDS=86400
# §3.7 Per-principal sustained limit.
DATAPIPELINES_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
# §3.7 Per-principal burst limit.
DATAPIPELINES_RATE_LIMIT_REQUESTS_PER_SECOND=100
# §3.6 How long a dropped SSE client may reconnect.
DATAPIPELINES_SSE_DISCONNECT_GRACE_SECONDS=30
# §3.6 SSE keep-alive interval.
DATAPIPELINES_SSE_HEARTBEAT_INTERVAL_SECONDS=15
# §3.6 Concurrent SSE streams one user may hold.
DATAPIPELINES_SSE_MAX_STREAMS_PER_USER=50
# §3.9 Compiled-template cache entries.
DATAPIPELINES_TEMPLATES_CACHE_SIZE=500
# §3.9 Largest template body accepted.
DATAPIPELINES_TEMPLATES_MAX_BODY_CHARS=262144
# §3.9 Template render deadline.
DATAPIPELINES_TEMPLATES_RENDER_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Presentation, retention and observability (configuration.md §3.10-§3.15)
# ----------------------------------------------------------------------------
# §3.12 How long audit rows are kept.
DATAPIPELINES_AUDIT_RETENTION_DAYS=365
# §3.11 full | structured — whether failures carry the chain and rendered SQL.
DATAPIPELINES_EXECUTIONS_ERROR_DETAIL=full
# §3.11 How long execution events are kept.
DATAPIPELINES_EXECUTIONS_EVENT_RETENTION_DAYS=7
# §3.11 After this, a RUNNING execution is reaped as stale.
DATAPIPELINES_EXECUTIONS_STALE_TIMEOUT_MINUTES=60
# §3.15 json | console. Human-readable on a terminal; set json in secrets.env when a
# log collector parses it.
DATAPIPELINES_OBSERVABILITY_LOGGING_FORMAT=console
# §3.15 Emit traces.
DATAPIPELINES_OBSERVABILITY_TRACING_ENABLED=false
# §3.10 A vendored design-system theme directory name. `dark` matches the marketing site
# (owner, 2026-09-11); each user can pick light/system/another palette in Settings.
DATAPIPELINES_UI_THEME=dark

# ----------------------------------------------------------------------------
# Organisation facts — in every execution Context (configuration.md §3.21)
# ----------------------------------------------------------------------------
# §3.21 In every execution Context as org_currency_name.
DATAPIPELINES_ORG_CURRENCY_NAME=Dollar
# §3.21 In every Context as org_currency_symbol. In compose YAML write it $$.
DATAPIPELINES_ORG_CURRENCY_SYMBOL=$
# §3.21 MM-DD, a real calendar day.
DATAPIPELINES_ORG_FISCAL_START_DATE=01-01
# §3.21 IANA zone id (a fixed offset is not one).
DATAPIPELINES_ORG_TIMEZONE=UTC
# §3.21 monday | sunday.
DATAPIPELINES_ORG_WEEK_START=monday

# ----------------------------------------------------------------------------
# Transform evaluation — the script-evaluation budgets (configuration.md §3.28)
# ----------------------------------------------------------------------------
# §3.28 Wall clock for one evaluate/test case. Must not exceed suite-timeout-seconds.
DATAPIPELINES_TRANSFORM_EVALUATE_TIMEOUT_SECONDS=10
# §3.28 Wall clock for the whole save/release test suite.
DATAPIPELINES_TRANSFORM_SUITE_TIMEOUT_SECONDS=60
# §3.28 Concurrent running script evaluations.
DATAPIPELINES_TRANSFORM_POOL_SIZE=4
# §3.28 Evaluations ADMITTED in total, running plus waiting.
DATAPIPELINES_TRANSFORM_POOL_QUEUE=64
# §3.28 Grace past the wall clock before an evaluation is abandoned. Must be >= 1.
DATAPIPELINES_TRANSFORM_ABANDON_GRACE_SECONDS=30
# §3.28 Row cap on any table input, checked before evaluation.
DATAPIPELINES_TRANSFORM_MAX_INPUT_ROWS=100000
# §3.28 Cap on a value/object output.
DATAPIPELINES_TRANSFORM_MAX_VALUE_BYTES=1048576
# §3.28 Cap on a single string in any returned row.
DATAPIPELINES_TRANSFORM_MAX_STRING_BYTES=1048576
# §3.28 Expression depth bound (time catches recursion, depth catches nesting).
DATAPIPELINES_TRANSFORM_MAX_DEPTH=100

# ----------------------------------------------------------------------------
# The scheduler (#9) — dispatch, capacity and guards (configuration.md §3.34)
# ----------------------------------------------------------------------------
# §3.34 This instance dispatches scheduled runs; false = API mode (REST only).
DATAPIPELINES_SCHEDULER_ENABLED=true
# §3.34 db-scheduler worker threads.
DATAPIPELINES_SCHEDULER_THREADS=2
# §3.34 db-scheduler's poll for due tasks.
DATAPIPELINES_SCHEDULER_POLLING_INTERVAL_SECONDS=10
# §3.34 db-scheduler's task heartbeat (a task is dead after six missed).
DATAPIPELINES_SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=30
# §3.34 The dispatcher's and the reconciler's fixed delay.
DATAPIPELINES_SCHEDULER_TICK_INTERVAL_SECONDS=10
# §3.34 Scheduled executions in flight per instance (the system identity's slot budget).
DATAPIPELINES_SCHEDULER_MAX_CONCURRENT_RUNS=4
# §3.34 How late a run may still be admitted (1..86400).
DATAPIPELINES_SCHEDULER_LATENESS_SECONDS=600
# §3.34 The `latest` catch-up policy's reach (1..604800).
DATAPIPELINES_SCHEDULER_CATCH_UP_MAX_AGE_SECONDS=86400
# §3.34 Shutdown's wait for in-flight scheduled launches (1..15).
DATAPIPELINES_SCHEDULER_SHUTDOWN_WAIT_SECONDS=5
# §3.34 Refuse a cron firing more often than this (>= 60).
DATAPIPELINES_SCHEDULER_MIN_INTERVAL_SECONDS=300
# §3.34 Live schedules per workspace.
DATAPIPELINES_SCHEDULER_MAX_SCHEDULES_PER_WORKSPACE=100

# ----------------------------------------------------------------------------
# The parameter engine (#194) — its limits (configuration.md §3.30)
# ----------------------------------------------------------------------------
# §3.30 Parameters in one set (1..256).
DATAPIPELINES_PARAMETERS_MAX_PARAMETERS_PER_SET=64
# §3.30 Options one selector may return; one more is too_many_options (1..10000).
DATAPIPELINES_PARAMETERS_MAX_OPTIONS_PER_SELECTOR=200
# §3.30 Values in one MULTI selection (1..1000).
DATAPIPELINES_PARAMETERS_MAX_MULTI_BIND_VALUES=1000
# §3.30 Placeholders in one rendered selector statement, every expanded one counted (1..2000).
DATAPIPELINES_PARAMETERS_MAX_BINDS_PER_STATEMENT=2000
# §3.30 Characters in one option value (1..65536).
DATAPIPELINES_PARAMETERS_MAX_OPTION_VALUE_CHARS=1024
# §3.30 Characters in one option label (1..4096).
DATAPIPELINES_PARAMETERS_MAX_OPTION_LABEL_CHARS=256
# §3.30 The max_length an INPUT string gets when it declares none (1..65536).
DATAPIPELINES_PARAMETERS_MAX_INPUT_LENGTH=4096
# §3.30 Nesting depth of a hidden/disabled expression (1..64).
DATAPIPELINES_PARAMETERS_MAX_EXPRESSION_DEPTH=16
# §3.30 Operators in one expression (1..1024).
DATAPIPELINES_PARAMETERS_MAX_EXPRESSION_NODES=128
# §3.30 The read budget of a pattern constraint's match (1000..10000000).
DATAPIPELINES_PARAMETERS_MAX_REGEX_STEPS=100000
# §3.30 Wall clock for one evaluate (1..300).
DATAPIPELINES_PARAMETERS_EVALUATE_TIMEOUT_SECONDS=30
# §3.30 One selector statement's timeout (1..evaluate-timeout-seconds).
DATAPIPELINES_PARAMETERS_SELECTOR_QUERY_TIMEOUT_SECONDS=10
# §3.30 Selector statements running at once (the bulkhead) (1..32).
DATAPIPELINES_PARAMETERS_MAX_CONCURRENT_SELECTOR_QUERIES=4
# §3.30 Selector statements admitted beyond the running ones (0..1024).
DATAPIPELINES_PARAMETERS_MAX_WAITING_SELECTOR_QUERIES=64
# §3.30 An evaluate response's byte budget (65536..67108864).
DATAPIPELINES_PARAMETERS_MAX_EVALUATE_RESPONSE_BYTES=4194304

# §3.31 The platform-wide request-body cap, 2 MiB (65536..67108864) — 413 request.body_too_large past it (#279).
DATAPIPELINES_WEB_MAX_REQUEST_BYTES=2097152

# §3.32 Batch the event record and the replay log (false = one write per row, the pre-#266 path; also gates the audit switch below).
DATAPIPELINES_PERSISTENCE_ENABLED=true
# §3.32 Items per batch at most (1..7000 — the replay log's Lua script unpacks one batch).
DATAPIPELINES_PERSISTENCE_BATCH_MAX_EVENTS=200
# §3.32 Bytes per batch at most, 1 MiB.
DATAPIPELINES_PERSISTENCE_BATCH_MAX_BYTES=1048576
# §3.32 How long a BUSY writer waits for a fuller batch; never at idle (0 = never).
DATAPIPELINES_PERSISTENCE_LINGER_MS=0
# §3.32 Items queued or in a commit, per writer.
DATAPIPELINES_PERSISTENCE_QUEUE_MAX_EVENTS=10000
# §3.32 The same in bytes, 32 MiB per writer.
DATAPIPELINES_PERSISTENCE_QUEUE_MAX_BYTES=33554432
# §3.32 A caller waits this long for its batch before writing its own row.
DATAPIPELINES_PERSISTENCE_RECORD_MAX_WAIT_MS=2000
# §3.32 Writer threads per store, and the dp-event-persist pool size.
DATAPIPELINES_PERSISTENCE_WRITERS=4
# §3.32 The shutdown drain bound, all writers in parallel (0..25000).
DATAPIPELINES_PERSISTENCE_SHUTDOWN_DRAIN_MS=10000
# §3.32 Batch the audit log too. Off: measured, audit rows never formed batches and the writer only raised their p99.
DATAPIPELINES_PERSISTENCE_AUDIT_ENABLED=false

# ----------------------------------------------------------------------------
# THE SAMPLE DATA (`--demo nyc,trade,lake`, docs/environments.md §5)
#
# TRACKED, and that is the point (T117): the version numbers used to live in a
# git-ignored scaffold, so two stacks in one week loaded a version the repo had
# already moved past and nobody could see it. A version bump is a COMMIT now, and
# scripts/sample-data/check-published.sh (nyc/trade) and
# scripts/sample-data-lake/check-published.sh (lake) read these values from THIS
# file. Any change to the data is a new immutable version directory
# (docs/deployment.md Appendix B).
# ----------------------------------------------------------------------------
# Where the published mobility artifacts live, and which version directory under it.
SAMPLE_BASE_URL=https://datapipelines-co.s3.amazonaws.com/sample-data/mobility
SAMPLE_VERSION=v8
# The same pair for the trade family.
SAMPLE_TRADE_BASE_URL=https://datapipelines-co.s3.amazonaws.com/sample-data/trade
SAMPLE_TRADE_VERSION=v4
# The same pair for the lake family — with the difference that NOTHING downloads:
# the base only locates the manifest the app's bootstrap fetches (089 §E), and
# the published objects are read in place at query time.
SAMPLE_LAKE_BASE_URL=https://datapipelines-co.s3.amazonaws.com/sample-data/lake
SAMPLE_LAKE_VERSION=v1
# The SELECT-only login the loader creates on Postgres and MySQL, and that the
# bootstrap datasources file resolves as a ${...} placeholder. The USER is not a
# secret; its passwords are, and they live in deploy/secrets.env.
SAMPLE_DB_USER=dp_demo_ro

# The `development` POSTURE — one variable, and the product does the rest.
#
# Load it with whatever your platform uses (docs/environments.md "Loaders"):
#   docker compose --env-file deploy/env/posture/development.env …
#   set -a; . deploy/env/posture/development.env; . deploy/secrets.env; set +a; java -jar app.jar
#   kubectl create configmap dp-posture --from-env-file=deploy/env/posture/development.env
#   systemd:  EnvironmentFile=/etc/datapipelines/development.env
#
# WHAT THE POSTURE MEANS (the normative table lives in docs/environments.md and
# docs/configuration.md §3.23; these are its `development` column):
#
#   authoring-enabled     true      — one box authors and runs
#   demo (DATAPIPELINES_DEMO)       allowed
#   local bootstrap password        allowed
#   loopback metadata DB / Redis    allowed
#   session cookie Secure           derived from DATAPIPELINES_AUTH_BASE_URL's scheme
#   OIDC                            optional (local accounts are enough)
#
# Those defaults are carried by the image's `application-development.yml`, which this
# variable selects. They are NOT repeated here as env vars on purpose: a second copy of
# a default is a second authority, and the two drift. Every one of them is still an
# ordinary variable you may set — in deploy/secrets.env, your configmap, or the shell:
#
#   DATAPIPELINES_DEPLOYMENT_AUTHORING_ENABLED=false
#   DATAPIPELINES_AUTH_COOKIE_SECURE=true
#
# deploy/env/example.env is the full reference of every variable.
DATAPIPELINES_POSTURE=development

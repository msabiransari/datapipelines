<?xml version="1.0" encoding="UTF-8"?>
<!--
  The house logging configuration (#337, observability.md §3.1/§3.5): stdout only, one CONSOLE
  appender whose encoder switches on datapipelines.observability.logging.format — the structured
  JSON line under `json`, the redacting development pattern under `console`. The switch is resolved
  here from the Spring environment AFTER the post-processor has validated it (an unknown value
  refuses startup before this file is parsed).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="DP_LOG_FORMAT" source="datapipelines.observability.logging.format" defaultValue="console"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder class="co.datapipelines.logging.FormatSwitchingEncoder">
            <format>${DP_LOG_FORMAT}</format>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

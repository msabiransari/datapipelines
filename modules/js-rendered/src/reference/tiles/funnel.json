[
 {
  "id": "five-stages",
  "title": "Five stages, the share of the first",
  "document": {
   "display_name": "From visit to renewal",
   "renderer": {
    "kind": "chart",
    "version": "1"
   },
   "inputs": {
    "result": {
     "columns": [
      {
       "name": "s",
       "type": "STRING",
       "nullable": false
      },
      {
       "name": "v",
       "type": "INTEGER",
       "nullable": true
      }
     ]
    }
   },
   "config": {
    "mark": {
     "type": "funnel"
    },
    "encoding": {
     "stage": {
      "field": "s",
      "type": "nominal",
      "sort": null
     },
     "value": {
      "field": "v",
      "type": "quantitative",
      "aggregate": "sum"
     }
    },
    "title": {
     "text": "From visit to renewal",
     "subtitle": "Last 30 days"
    }
   }
  },
  "columns": {
   "s": [
    "Visited",
    "Signed up",
    "Activated",
    "Subscribed",
    "Renewed"
   ],
   "v": [
    12400,
    5300,
    3100,
    1240,
    890
   ]
  },
  "types": {
   "s": "STRING",
   "v": "INTEGER"
  },
  "frame": {
   "w": 480,
   "h": 300
  },
  "hidden": [],
  "expect": {
   "state": "rendered",
   "level": "full",
   "legend": "none",
   "struck": [],
   "dots": 0
  }
 },

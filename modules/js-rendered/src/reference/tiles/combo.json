  {
    "document": {
      "display_name": "bar-line",
      "renderer": {
        "kind": "chart",
        "version": "1"
      },
      "inputs": {
        "result": {
          "columns": [
            {
              "name": "m",
              "type": "STRING",
              "nullable": true
            },
            {
              "name": "rev",
              "type": "INTEGER",
              "nullable": true
            },
            {
              "name": "cost",
              "type": "INTEGER",
              "nullable": true
            },
            {
              "name": "rate",
              "type": "DOUBLE",
              "nullable": true
            },
            {
              "name": "n",
              "type": "INTEGER",
              "nullable": true
            }
          ]
        }
      },
      "config": {
        "mark": {
          "type": "combo"
        },
        "encoding": {
          "x": {
            "field": "m",
            "type": "nominal",
            "sort": null
          },
          "layers": [
            {
              "mark": "bar",
              "y": {
                "field": "rev",
                "type": "quantitative",
                "aggregate": "sum",
                "title": "Revenue"
              },
              "title": "Revenue"
            },
            {
              "mark": "line",
              "axis": "right",
              "y": {
                "field": "rate",
                "type": "quantitative",
                "aggregate": "mean",
                "title": "Rate",
                "format": "percent"
              },
              "title": "Rate"
            }
          ]
        },
        "title": {
          "text": "Revenue and rate"
        }
      }
    },
    "columns": {
      "m": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun"
      ],
      "rev": [
        100,

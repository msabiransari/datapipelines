{
  "schema_version": 1,
  "name": "pure_etl",
  "display_name": "Pure ETL",
  "description": "No node resolves to caller — §9.4. Returns execution stats only.",
  "parameters": {},
  "nodes": [
    {
      "id": "fetch_orders",
      "description": "Pull orders from PG.",
      "type": "DQL",
      "source": "pg-prod",
      "template": {"id": "fetch_orders.sql", "version": 1},
      "output": {"target": "tempdb", "table": "stg_orders"},
      "depends_on": []
    },
    {
      "id": "transform",
      "description": "Transform in tempdb.",
      "type": "DQL",
      "source": "tempdb",
      "template": {"id": "transform.sql", "version": 1},
      "output": {"target": "tempdb", "table": "int_orders"},
      "depends_on": ["fetch_orders"]
    },
    {
      "id": "write_to_warehouse",
      "description": "Append to the warehouse.",
      "type": "DQL",
      "source": "tempdb",
      "template": {"id": "select_orders.sql", "version": 1},
      "output": {
        "target": "datasource",
        "datasource": "pg-warehouse",
        "table": "daily_orders_materialized",
        "mode": "append"
      },
      "depends_on": ["transform"]
    }
  ]
}

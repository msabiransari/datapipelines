{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapipelines.co/schemas/chart/1/box.schema.json",
  "$comment": "Box: design record \u00a74.5 and brief 1072 D3.",
  "title": "datapipelines chart document, version 1, family box",
  "description": "Quartiles, median and whiskers per category; outside points optional.",
  "type": "object",
  "allOf": [
    {
      "$ref": "skeleton.schema.json"
    }
  ],
  "properties": {
    "config": {
      "$ref": "#/$defs/config"
    }
  },
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark",
        "encoding"
      ],
      "properties": {
        "title": {
          "$ref": "skeleton.schema.json#/$defs/title"
        },
        "mark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "box"
            },
            "outliers": {
              "enum": [
                "none",
                "points"
              ]
            }
          }
        },
        "encoding": {
          "$ref": "#/$defs/encoding"
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
          "$ref": "#/$defs/y"
        }
      }
    },
    "y": {
      "description": "One quantitative value per input row; no aggregation.",
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/position"
        }
      ],
      "properties": {
        "type": {
          "const": "quantitative"
        }
      }
    },
    "x": {
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/band"
        }
      ],
      "properties": {
        "sort": {
          "$ref": "skeleton.schema.json#/$defs/orderSort"
        }
      }
    }
  }
}

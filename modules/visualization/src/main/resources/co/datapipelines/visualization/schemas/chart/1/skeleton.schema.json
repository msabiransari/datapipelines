{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapipelines.co/schemas/chart/1/skeleton.schema.json",
  "$comment": "Product copy of the 854 lane schema, amended by lane #860 per design record 2026-11-06-neutral-chart-grammar: §4.2 (display_name 1-120, description <= 2000, presentation refused on a chart document) and R11 (plain text refuses control characters only; < and > are allowed and escaped at render). Served unchanged at /schemas/chart/1/skeleton.schema.json.",
  "title": "datapipelines chart document, renderer.kind = chart, renderer.version = 1 (skeleton)",
  "description": "The document shape shared by every chart family (spec/skeleton.md). config is one family's configuration, chosen from the family registry ($defs/familyConfig); each family schema (bar.schema.json, line.schema.json, area.schema.json) defines its config and narrows this document to it. The channel shapes the families share (band, value, position, series, scale, detail; design record 2026-11-14-js-rendered-charts §4.4) are defined here once. Every object is closed (additionalProperties: false). Version 1 is the path segment of every $id: an incompatible change is version 2 at a new path, never an edit here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "renderer",
    "inputs",
    "config"
  ],
  "properties": {
    "description": {
      "$ref": "#/$defs/longText"
    },
    "display_name": {
      "$ref": "#/$defs/displayName"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "chart"
        },
        "version": {
          "const": "1"
        }
      }
    },
    "inputs": {
      "description": "Named input contracts (VisualizationBody.inputs). Without a transform exactly one input is bound (the chart reads its columns); with a transform the chart reads the transform's OUTPUT and the save check is given that output contract.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/inputName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/inputContract"
      }
    },
    "transform": {
      "$ref": "#/$defs/transform"
    },
    "config": {
      "$ref": "#/$defs/familyConfig"
    },
    "bindings": {
      "description": "Derived, never authored: encoded field -> column, one entry per distinct encoded field, each mapping to itself (the save check refuses any other map, chart.bindings.mismatch). The runtime then delivers {field: [values]} (RefreshEngine.kt:360 unchanged).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/fieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fieldName"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    }
  },
  "if": {
    "not": {
      "type": "object",
      "required": [
        "transform"
      ]
    }
  },
  "then": {
    "type": "object",
    "properties": {
      "inputs": {
        "type": "object",
        "maxProperties": 1
      }
    }
  },
  "$defs": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "subtitle": {
          "$ref": "#/$defs/plainTextRequired"
        }
      }
    },
    "familyConfig": {
      "description": "The family registry: one entry per v1 family schema (enums.md §63, ChartType): bar, line, area, scatter, pie, heatmap.",
      "oneOf": [
        {
          "$ref": "bar.schema.json#/$defs/config"
        },
        {
          "$ref": "line.schema.json#/$defs/config"
        },
        {
          "$ref": "area.schema.json#/$defs/config"
        },
        {
          "$ref": "scatter.schema.json#/$defs/config"
        },
        {
          "$ref": "pie.schema.json#/$defs/config"
        },
        {
          "$ref": "heatmap.schema.json#/$defs/config"
        }
      ]
    },
    "plainText": {
      "description": "Plain text shown to a person (design record R11): no control characters (Unicode general category Cc, U+0000-U+001F and U+007F-U+009F), at most 200 characters; < and > are allowed, and every converter escapes every sink (spec/skeleton.md#text).",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "plainTextRequired": {
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "displayName": {
      "description": "The document display name: plain text of 1-120 characters (the product bound, DocumentRules.MAX_DISPLAY_NAME_CHARS; design record §4.2). maxLength counts Unicode code points; the product also counts UTF-16 units and refuses a blank name at save, so 61 supplementary characters pass this schema and are refused by the product.",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainTextRequired"
        }
      ],
      "maxLength": 120
    },
    "longText": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]*$",
      "description": "Longer plain text (the document description): line feeds allowed, no other control character, < and > allowed (R11), at most 2000 characters (the product bound, design record §4.2)."
    },
    "inputName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "fieldName": {
      "description": "A column name of the bound input (or of the transform's output): 1-128 characters, no control character (VisualizationValidator's column grammar).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "logicalType": {
      "enum": [
        "NULL",
        "BOOLEAN",
        "INTEGER",
        "BIGINTEGER",
        "DECIMAL",
        "BIGDECIMAL",
        "STRING",
        "BINARY",
        "DATE",
        "TIME",
        "TIMESTAMP"
      ]
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "type": {
                "$ref": "#/$defs/logicalType"
              },
              "name": {
                "$ref": "#/$defs/fieldName"
              },
              "nullable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "inputs"
      ],
      "properties": {
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[a-z0-9_.-]+(/[a-z0-9_.-]+){1,9}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/inputName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputName"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fixtures",
              "assertions"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/plainTextRequired"
              },
              "fixtures": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/inputName"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "$ref": "#/$defs/fieldName"
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "rendered",
                        "no_console_errors",
                        "text_visible",
                        "no_data",
                        "mark_count"
                      ]
                    },
                    "equals": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "$ref": "#/$defs/plainText"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "channelTitle": {
      "description": "Absent = the default title (field name, or aggregate and field); null = no title.",
      "oneOf": [
        {
          "$ref": "#/$defs/plainTextRequired"
        },
        {
          "type": "null"
        }
      ]
    },
    "bandType": {
      "enum": [
        "nominal",
        "ordinal",
        "temporal"
      ]
    },
    "seriesType": {
      "enum": [
        "nominal",
        "ordinal"
      ]
    },
    "aggregate": {
      "enum": [
        "sum",
        "mean",
        "min",
        "max",
        "count"
      ]
    },
    "temporalFormat": {
      "description": "UTC label granularity (D-D).",
      "enum": [
        "date",
        "month",
        "year",
        "datetime"
      ]
    },
    "numberFormat": {
      "description": "The named number formats: integer | decimal(n), n = 0..6 | percent | compact | currency(ISO 4217 code). Rendered by the converter, never a library format string.",
      "type": "string",
      "pattern": "^(integer|percent|compact|decimal\\([0-6]\\)|currency\\([A-Z]{3}\\))$"
    },
    "valueList": {
      "description": "An explicit order: the category (or series) values as text, each once.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "orderSort": {
      "description": "ascending | descending (by the value itself: code point order for text, numeric for numbers, time for temporal) | null (input order, first appearance) | an explicit list.",
      "oneOf": [
        {
          "enum": [
            "ascending",
            "descending",
            null
          ]
        },
        {
          "$ref": "#/$defs/valueList"
        }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grid": {
          "type": "boolean"
        }
      }
    },
    "legend": {
      "description": "null = no legend.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orient": {
              "enum": [
                "top",
                "bottom",
                "left",
                "right"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "description": "[min, max] of an axis. The save check refuses min >= max, a linear range without zero where the axis always holds zero (bar, area, or scale.zero true; chart.scale.domain_invalid), and on a log scale min <= 0 (chart.scale.domain_log).",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "legendDirect": {
      "description": "null = no legend. direct = the series names written after the lines' last points (line and area only; the default with 2 to 4 series).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orient": {
              "enum": [
                "top",
                "bottom",
                "left",
                "right",
                "direct"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "description": "G6: a unit written after the number in tooltips, value labels and the value axis's title, never on a tick: plain text of 1 to 16 characters.",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainTextRequired"
        }
      ],
      "maxLength": 16
    },
    "scale": {
      "description": "G4, G8: the axis's range, its type (linear default, or log: no zero, ticks on 1, 2, 5 × 10^k) and whether it holds zero (line: default false; bar and area: always true). The save check refuses log on an area, on a stacked or normalized value and beside zero (chart.scale.log_unsupported).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "type": {
          "enum": [
            "linear",
            "log"
          ]
        },
        "zero": {
          "type": "boolean"
        }
      }
    },
    "band": {
      "description": "A category axis (record §4.4 band): nominal, ordinal or temporal values, evenly spaced in the sort's order; format only on temporal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type",
        "sort"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/channelTitle"
        },
        "type": {
          "$ref": "#/$defs/bandType"
        },
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "sort": true,
        "format": {
          "$ref": "#/$defs/temporalFormat"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "temporal"
          }
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": [
            "format"
          ]
        }
      }
    },
    "value": {
      "description": "A measure (record §4.4 value): an aggregate of field, of each entry of fields (G1), or a count; G4's scale and G6's unit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "aggregate"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/channelTitle"
        },
        "type": {
          "const": "quantitative"
        },
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "fields": {
          "description": "G1: series from columns, 2 to 8, instead of field: the fields ARE the series, in the list's order (a colour channel is then refused); title is the legend text, unit G6's per entry.",
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "stack": {
          "description": "zero = stacked, normalize = stacked to 100 % of each category, null = side by side (bar) or overlapping (area). Where a family admits it is its own rule (bar: required with color, forbidden otherwise; area: only with color or fields; line: never).",
          "enum": [
            "zero",
            "normalize",
            null
          ]
        },
        "format": {
          "$ref": "#/$defs/numberFormat"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "aggregate": {
            "const": "count"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "field"
              ]
            },
            {
              "type": "object",
              "required": [
                "fields"
              ]
            }
          ]
        }
      },
      "else": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "field"
            ]
          },
          {
            "type": "object",
            "required": [
              "fields"
            ]
          }
        ]
      }
    },
    "fieldEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "series": {
      "description": "Series by a column's values (record §4.4 series). Each family narrows legend: bar to $defs/legend, line and area to $defs/legendDirect.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type",
        "sort"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/channelTitle"
        },
        "type": {
          "$ref": "#/$defs/seriesType"
        },
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "sort": {
          "$ref": "#/$defs/orderSort"
        },
        "legend": true
      }
    },
    "shade": {
      "description": "Colour by value (record §4.4 shade, G3): the aggregate of field over a mark's rows on a colour scale, sequential (seven steps from the smallest to the largest value) or diverging (two-sided around mid, zero where none is given; mid is admitted with diverging only). count counts the mark's rows whose field is not null. legend: a place, or null for none. A family narrows scale to what its engine draws.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "aggregate",
        "type",
        "scale"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "type": {
          "const": "quantitative"
        },
        "scale": {
          "enum": [
            "sequential",
            "diverging"
          ]
        },
        "mid": {
          "type": "number"
        },
        "legend": {
          "$ref": "#/$defs/legend"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "scale": {
            "const": "sequential"
          }
        }
      },
      "then": {
        "not": {
          "type": "object",
          "required": [
            "mid"
          ]
        }
      }
    },
    "size": {
      "description": "Size by value (record §4.4 size): field's value as a mark's diameter in px, in range [min, max], each 4 to 64 (default [6, 40]); the area follows the value. That min is below max is a save rule (chart.size.range_invalid). Used by types that come later.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 4,
            "maximum": 64
          }
        }
      }
    },
    "count": {
      "description": "A count of rows (record §4.4 count): count, or share of the whole; it carries no field. Used by types that come later.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate"
      ],
      "properties": {
        "aggregate": {
          "enum": [
            "count",
            "share"
          ]
        }
      }
    },
    "level": {
      "description": "One level of a hierarchy (record §4.4 level): a nominal or ordinal column, not nullable (a save rule, chart.category.nullable). Used by types that come later.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        }
      }
    },
    "position": {
      "description": "A continuous axis (record §4.4 position) with no aggregation: quantitative (a number axis, linear or log) or temporal (a continuous UTC time axis; its format is G9's granularity, no scale and no unit).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/channelTitle"
        },
        "type": {
          "enum": [
            "quantitative",
            "temporal"
          ]
        },
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "format": true,
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "temporal"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "format": {
            "$ref": "#/$defs/temporalFormat"
          }
        },
        "not": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "scale"
              ]
            },
            {
              "type": "object",
              "required": [
                "unit"
              ]
            }
          ]
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "format": {
            "$ref": "#/$defs/numberFormat"
          }
        }
      }
    },
    "detail": {
      "description": "G7: one extra tooltip line, \"title: value\", of any column of the input.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldName"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/numberFormat"
            },
            {
              "$ref": "#/$defs/temporalFormat"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "tooltip": {
      "description": "G7: at most 6 detail lines, carried on each mark.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/detail"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapipelines.co/schemas/chart/1/bar.schema.json",
  "$comment": "Product copy of the 854 lane schema (lane #860, design record 2026-11-06-neutral-chart-grammar §4.3); lane 989 (design record 2026-11-14-js-rendered-charts §4.4, D2) moved band, value and series to the skeleton's $defs and admits G1, G4, G6, G7 and G8. Lane 1050 (design record §9 G2) admits color: shade beside series. Served at /schemas/chart/1/bar.schema.json.",
  "title": "datapipelines chart document, version 1, family bar",
  "description": "A skeleton document whose config is a bar config (spec/bar.md). Orientation is not a field: it is derived from which channel is quantitative (y = vertical bars, x = horizontal bars); exactly one of the two encodings matches.",
  "type": "object",
  "allOf": [
    {
      "$ref": "skeleton.schema.json"
    }
  ],
  "properties": {
    "config": {
      "$ref": "#/$defs/config"
    }
  },
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark",
        "encoding"
      ],
      "properties": {
        "title": {
          "$ref": "skeleton.schema.json#/$defs/title"
        },
        "mark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "bar"
            },
            "labels": {
              "description": "values = each bar carries its formatted value; none (default) = no value labels.",
              "enum": [
                "none",
                "values"
              ]
            }
          }
        },
        "encoding": {
          "oneOf": [
            {
              "$ref": "#/$defs/vertical"
            },
            {
              "$ref": "#/$defs/horizontal"
            }
          ]
        }
      }
    },
    "vertical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/bandVertical"
        },
        "y": {
          "$ref": "#/$defs/value"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "tooltip": {
          "$ref": "skeleton.schema.json#/$defs/tooltip"
        }
      },
      "if": {
        "type": "object",
        "required": [
          "color"
        ],
        "properties": {
          "color": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nominal",
                  "ordinal"
                ]
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "y": {
            "type": "object",
            "required": [
              "stack"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "y": {
            "not": {
              "type": "object",
              "required": [
                "stack"
              ]
            }
          }
        }
      },
      "not": {
        "description": "G1: with fields the fields are the series, so a colour channel is refused.",
        "type": "object",
        "required": [
          "color"
        ],
        "properties": {
          "y": {
            "type": "object",
            "required": [
              "fields"
            ]
          }
        }
      }
    },
    "horizontal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "y": {
          "$ref": "#/$defs/bandHorizontal"
        },
        "x": {
          "$ref": "#/$defs/value"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "tooltip": {
          "$ref": "skeleton.schema.json#/$defs/tooltip"
        }
      },
      "if": {
        "type": "object",
        "required": [
          "color"
        ],
        "properties": {
          "color": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nominal",
                  "ordinal"
                ]
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "x": {
            "type": "object",
            "required": [
              "stack"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "x": {
            "not": {
              "type": "object",
              "required": [
                "stack"
              ]
            }
          }
        }
      },
      "not": {
        "description": "G1: with fields the fields are the series, so a colour channel is refused.",
        "type": "object",
        "required": [
          "color"
        ],
        "properties": {
          "x": {
            "type": "object",
            "required": [
              "fields"
            ]
          }
        }
      }
    },
    "bandVertical": {
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/band"
        }
      ],
      "properties": {
        "sort": {
          "description": "The band order, required (a library's default order is never relied on). y / -y = by the category's value (its stack or group total), ascending / descending.",
          "oneOf": [
            {
              "$ref": "skeleton.schema.json#/$defs/orderSort"
            },
            {
              "enum": [
                "y",
                "-y"
              ]
            }
          ]
        }
      }
    },
    "bandHorizontal": {
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/band"
        }
      ],
      "properties": {
        "sort": {
          "description": "As bandVertical, by the x channel. The first category in the order is drawn at the TOP.",
          "oneOf": [
            {
              "$ref": "skeleton.schema.json#/$defs/orderSort"
            },
            {
              "enum": [
                "x",
                "-x"
              ]
            }
          ]
        }
      }
    },
    "value": {
      "description": "The skeleton's value; on a bar the axis always holds zero (G8: scale.zero false is refused).",
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/value"
        }
      ],
      "properties": {
        "scale": {
          "type": "object",
          "properties": {
            "zero": {
              "const": true
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/series"
        }
      ],
      "properties": {
        "legend": {
          "$ref": "skeleton.schema.json#/$defs/legend"
        }
      }
    },
    "color": {
      "description": "Series by a column's values (nominal, ordinal: then the value's stack is required), or colour by value (quantitative: the shade; the value's stack is refused, as without a colour). The object's own type selects which, so a refusal names the one it meant.",
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "quantitative"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/shade"
      },
      "else": {
        "$ref": "#/$defs/series"
      }
    },
    "shade": {
      "description": "The skeleton's shade: on a bar the scale is sequential or diverging (two-sided around mid, zero where none is given), as the skeleton says.",
      "type": "object",
      "allOf": [
        {
          "$ref": "skeleton.schema.json#/$defs/shade"
        }
      ]
    }
  }
}

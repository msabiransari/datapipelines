{
  "display_name": "gauge-target-below-domain",
  "renderer": {
    "kind": "chart",
    "version": "1"
  },
  "inputs": {
    "result": {
      "columns": [
        {
          "name": "v",
          "type": "INTEGER",
          "nullable": true
        }
      ]
    }
  },
  "config": {
    "mark": {
      "type": "gauge",
      "target": -1
    },
    "encoding": {
      "value": {
        "field": "v",
        "type": "quantitative",
        "aggregate": "sum",
        "scale": {
          "domain": [
            0,
            100
          ]
        }
      }
    }
  },
  "description": "gauge target below domain"
}

{
 "display_name": "Shade with fields",
 "description": "A shade beside fields.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "month",
     "type": "DATE"
    },
    {
     "name": "channel",
     "type": "STRING"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "payload",
     "type": "BINARY",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "bar"
  },
  "encoding": {
   "x": {
    "field": "region",
    "type": "nominal",
    "sort": "ascending",
    "title": "Region"
   },
   "y": {
    "type": "quantitative",
    "aggregate": "sum",
    "title": "Amount",
    "format": "compact",
    "fields": [
     {
      "field": "amount"
     },
     {
      "field": "units"
     }
    ]
   },
   "color": {
    "field": "units",
    "type": "quantitative",
    "aggregate": "sum",
    "scale": "sequential"
   }
  },
  "title": {
   "text": "Shade with fields"
  }
 }
}

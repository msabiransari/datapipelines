{
  "display_name": "gauge-target-above-domain",
  "renderer": {
    "kind": "chart",
    "version": "1"
  },
  "inputs": {
    "result": {
      "columns": [
        {
          "name": "v",
          "type": "INTEGER",
          "nullable": true
        }
      ]
    }
  },
  "config": {
    "mark": {
      "type": "gauge",
      "bands": [
        {
          "to": 50,
          "tone": "bad"
        },
        {
          "to": 100,
          "tone": "good"
        }
      ],
      "target": 130
    },
    "encoding": {
      "value": {
        "field": "v",
        "type": "quantitative",
        "aggregate": "sum",
        "scale": {
          "domain": [
            0,
            100
          ]
        }
      }
    }
  },
  "description": "gauge target above domain"
}

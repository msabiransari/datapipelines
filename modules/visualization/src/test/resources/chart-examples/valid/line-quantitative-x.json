{
 "display_name": "Amount by units",
 "description": "A quantitative x is a number axis.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "month",
     "type": "DATE"
    },
    {
     "name": "channel",
     "type": "STRING"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "payload",
     "type": "BINARY",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "line"
  },
  "encoding": {
   "x": {
    "field": "units",
    "type": "quantitative",
    "title": "Units",
    "unit": "pcs",
    "scale": {
     "type": "log"
    }
   },
   "y": {
    "field": "amount",
    "type": "quantitative",
    "aggregate": "sum",
    "format": "compact"
   }
  },
  "title": {
   "text": "Example"
  }
 }
}

{
 "display_name": "Amount by region",
 "description": "G6 unit, G7 tooltip and G8 zero true on a bar.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "month",
     "type": "DATE"
    },
    {
     "name": "channel",
     "type": "STRING"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "payload",
     "type": "BINARY",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "bar"
  },
  "encoding": {
   "x": {
    "field": "region",
    "type": "nominal",
    "sort": "ascending",
    "title": "Region"
   },
   "y": {
    "field": "amount",
    "type": "quantitative",
    "aggregate": "sum",
    "format": "compact",
    "unit": "USD",
    "scale": {
     "zero": true
    }
   },
   "tooltip": [
    {
     "field": "segment",
     "title": "Segment"
    },
    {
     "field": "units",
     "title": "Units",
     "format": "integer",
     "unit": "pcs"
    }
   ]
  },
  "title": {
   "text": "Example"
  }
 }
}

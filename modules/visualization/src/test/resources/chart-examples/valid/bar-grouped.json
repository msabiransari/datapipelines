{
 "display_name": "Amount by region and channel",
 "description": "Total amount per region, one bar per channel.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "month",
     "type": "DATE"
    },
    {
     "name": "channel",
     "type": "STRING"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "payload",
     "type": "BINARY",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "bar"
  },
  "encoding": {
   "x": {
    "field": "region",
    "type": "nominal",
    "sort": [
     "West",
     "North",
     "South"
    ],
    "title": "Region"
   },
   "y": {
    "field": "amount",
    "type": "quantitative",
    "aggregate": "sum",
    "stack": null,
    "format": "decimal(0)"
   },
   "color": {
    "field": "channel",
    "type": "nominal",
    "sort": "ascending",
    "title": "Channel",
    "legend": {
     "orient": "top"
    }
   }
  },
  "title": {
   "text": "Amount by region and channel"
  }
 }
}

{
 "display_name": "Amount and units by month",
 "description": "G1 series from columns, G6 units, G7 tooltip lines.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "month",
     "type": "DATE"
    },
    {
     "name": "channel",
     "type": "STRING"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "payload",
     "type": "BINARY",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "line"
  },
  "encoding": {
   "x": {
    "field": "month",
    "type": "temporal",
    "format": "month",
    "title": "Month"
   },
   "y": {
    "type": "quantitative",
    "aggregate": "sum",
    "fields": [
     {
      "field": "amount",
      "title": "Amount",
      "unit": "USD"
     },
     {
      "field": "units",
      "title": "Units"
     }
    ],
    "title": "Value"
   },
   "tooltip": [
    {
     "field": "segment",
     "title": "Segment"
    },
    {
     "field": "units",
     "title": "Units",
     "format": "integer",
     "unit": "pcs"
    }
   ]
  },
  "title": {
   "text": "Example"
  }
 }
}

{
 "display_name": "Amount against units sized by weight",
 "description": "The bubble chart: size by a third measure.",
 "renderer": {
  "kind": "chart",
  "version": "1"
 },
 "inputs": {
  "sales": {
   "columns": [
    {
     "name": "region",
     "type": "STRING"
    },
    {
     "name": "day",
     "type": "DATE"
    },
    {
     "name": "amount",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "units",
     "type": "INTEGER"
    },
    {
     "name": "weight",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "margin",
     "type": "DECIMAL",
     "nullable": true
    },
    {
     "name": "segment",
     "type": "STRING"
    },
    {
     "name": "name",
     "type": "STRING",
     "nullable": true
    }
   ]
  }
 },
 "config": {
  "mark": {
   "type": "scatter"
  },
  "encoding": {
   "x": {
    "field": "units",
    "type": "quantitative",
    "title": "Units"
   },
   "y": {
    "field": "amount",
    "type": "quantitative",
    "title": "Amount",
    "format": "compact"
   },
   "size": {
    "field": "weight",
    "range": [
     4,
     64
    ]
   },
   "color": {
    "field": "segment",
    "type": "nominal",
    "sort": null,
    "title": "Segment"
   }
  },
  "title": {
   "text": "Example"
  }
 }
}

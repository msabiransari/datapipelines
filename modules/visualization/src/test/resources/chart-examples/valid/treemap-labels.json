{
  "display_name": "plain",
  "renderer": {
    "kind": "chart",
    "version": "1"
  },
  "inputs": {
    "result": {
      "columns": [
        {
          "name": "a",
          "type": "STRING",
          "nullable": false
        },
        {
          "name": "v",
          "type": "INTEGER",
          "nullable": true
        }
      ]
    }
  },
  "config": {
    "mark": {
      "type": "treemap",
      "labels": "names"
    },
    "encoding": {
      "path": [
        {
          "field": "a"
        }
      ],
      "size": {
        "field": "v",
        "aggregate": "sum",
        "type": "quantitative"
      }
    }
  }
}
